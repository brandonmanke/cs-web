{
  "name": "cs-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm && npm run typecheck && vite build",
    "preview": "vite preview",
    "wasm": "emcmake cmake -B build/wasm -DCMAKE_BUILD_TYPE=Release && cmake --build build/wasm -j",
    "test": "cmake --preset native && cmake --build --preset native -j && ctest --preset native",
    "mapcheck": "esbuild tools/mapcheck.ts --bundle --platform=node --format=esm --outfile=build/mapcheck.mjs --log-level=error && node build/mapcheck.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
